digraph ResBlock {
    rankdir=LR;

    x [shape=oval, style=filled, fillcolor=lightgreen];

    conv1 [label="conv1\nConv2d", shape=box, style=filled, fillcolor="orange"];
    bn1 [label="bn1\nBatchNorm2d", shape=box, style=filled, fillcolor="plum"];
    relu1 [label="relu1\nReLU", shape=box, style=filled, fillcolor="lightgreen"];
    conv2 [label="conv2\nConv2d", shape=box, style=filled, fillcolor="orange"];
    bn2 [label="bn2\nBatchNorm2d", shape=box, style=filled, fillcolor="plum"];
    skip [label="skip\nResidual", shape=box, style=filled, fillcolor="gold"];
    relu2 [label="relu2\nReLU", shape=box, style=filled, fillcolor="lightgreen"];
    out [label="out\nFlatten", shape=box, style=filled, fillcolor="gray90", penwidth=2];

    x -> conv1;
    conv1 -> bn1;
    bn1 -> relu1;
    relu1 -> conv2;
    conv2 -> bn2;
    bn2 -> skip;
    x -> skip [label="shortcut"];
    skip -> relu2;
    relu2 -> out;
}